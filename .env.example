# ── Database ────────────────────────────────────────────────────────────
# Any managed Postgres works: Neon (neon.tech), Supabase, Railway, RDS, etc.
# For local development you can also run `docker compose up -d` (see
# docker-compose.yml) and use the value below as-is.
DATABASE_URL="postgresql://digibase:digibase@localhost:5432/digibase?schema=public"

# ── Email notifications (Resend) ───────────────────────────────────────
# Create a free account at https://resend.com, verify your sending domain,
# and generate an API key.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Must be an address on a domain verified in Resend (e.g. notifications@digibase.am).
# For local testing you can use Resend's shared onboarding@resend.dev sender.
EMAIL_FROM="DigiBase Website <notifications@digibase.am>"
# Where contact form notifications should be delivered.
EMAIL_TO="info@digibase.am"

# ── SMS notifications (optional, Twilio) ───────────────────────────────
# The contact form works fully without these — SMS is only sent when
# ENABLE_SMS_NOTIFICATIONS=true AND all Twilio variables below are set.
ENABLE_SMS_NOTIFICATIONS="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
SMS_FROM=""
SMS_TO=""

# ── Admin dashboard (/admin) ───────────────────────────────────────────
# Shared secret required to view and manage contact submissions.
# Generate a strong random value, e.g.: openssl rand -hex 32
ADMIN_API_TOKEN=""
